# MyLifeOS Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# TikTok API Key (RapidAPI)
# Get your key from: https://rapidapi.com/DataCrawler/api/tiktok-scraper7
TIKTOK_API_KEY=your_tiktok_api_key_here

# Gemini AI API Key (Google)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional - for cloud sync)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
